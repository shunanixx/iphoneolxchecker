# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Gemini API key from Google AI Studio
GEMINI_API_KEY=

# Gemini model id — the Lite variant of the current generation carries
# the most generous free-tier RPM
GEMINI_MODEL=gemini-3.5-flash-lite

# Requests-per-minute ceiling for the Gemini limiter — meant to match
# Google's actual free-tier ceiling for the model above, not add a
# tighter throttle on top of it. Google no longer publishes exact RPM
# per model in public docs; confirm the live number for your project at
# https://aistudio.google.com/rate-limit and raise/lower this to match —
# 15 here is a conservative placeholder, not a confirmed figure
GEMINI_RPM=15

# Max listing photos sent to the model per analysis
GEMINI_MAX_PHOTOS=4

# SQLite file
DB_PATH=./data/bot.db

# How often the background monitor polls OLX (seconds)
POLL_INTERVAL_SEC=600

# uk / ru / en
DEFAULT_LANGUAGE=uk

# OLX politeness knobs
OLX_BASE_URL=https://www.olx.ua
OLX_MAX_CONCURRENCY=3
OLX_MIN_DELAY_SEC=1.0
OLX_MAX_DELAY_SEC=3.0
OLX_PAGES_PER_MODEL=1

# DEBUG / INFO / WARNING
LOG_LEVEL=INFO
